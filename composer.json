{
	"$schema": "https://getcomposer.org/schema.json",
	"name": "mirite/cant-stop-wont-stop",
	"type": "project",
	"description": "The custom component of our wedding website",
	"require": {
		"dedmytro/laravel-cloudflare-images": "^0.2.2",
		"inertiajs/inertia-laravel": "^2.0.5",
		"laravel/framework": "^12.24.0",
		"laravel/sanctum": "^4.2",
		"laravel/tinker": "^2.10.1",
		"tightenco/ziggy": "^2.5.3"
	},
	"require-dev": {
		"barryvdh/laravel-ide-helper": "^3.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1.2",
		"fakerphp/faker": "^1.24.1",
		"laravel/breeze": "^2.3.8",
		"laravel/pail": "^1.2.3",
		"laravel/pint": "^1.24",
		"laravel/sail": "^1.44",
		"mirite/formatting": "dev-main",
		"mockery/mockery": "^1.6.12",
		"nunomaduro/collision": "^8.8.2",
		"phpcsstandards/phpcsutils": "^1.1.1",
		"phpstan/extension-installer": "^1.4.3",
		"phpstan/phpstan": "^2.1.22",
		"phpunit/phpunit": "^11.5.33",
		"roave/security-advisories": "dev-latest",
		"squizlabs/php_codesniffer": "^3.13.2",
		"wp-coding-standards/wpcs": "dev-main"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Database\\Factories\\": "database/factories/",
			"Database\\Seeders\\": "database/seeders/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"post-autoload-dump": [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover --ansi"
		],
		"post-update-cmd": [
			"@php artisan vendor:publish --tag=laravel-assets --ansi --force"
		],
		"post-root-package-install": [
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
		],
		"post-create-project-cmd": [
			"@php artisan key:generate --ansi",
			"@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
			"@php artisan migrate --graceful --ansi"
		],
		"dev": [
			"Composer\\Config::disableProcessTimeout",
			"npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
		],
		"format": "php-cs-fixer fix && phpcbf ./ --standard=phpcs.xml --extensions=php --ignore=vendor/,node_modules",
		"lint": "phpcs ./ --standard=phpcs.xml --extensions=php --ignore=vendor/,node_modules & phpstan analyze"
	},
	"extra": {
		"laravel": {
			"dont-discover": []
		}
	},
	"config": {
		"platform": {
			"php": "8.4"
		},
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"pestphp/pest-plugin": true,
			"php-http/discovery": true,
			"phpstan/extension-installer": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
